# Environment Variables for Suraksha SafeCity Full-Stack Platform

# Server Configuration
PORT=3000
NODE_ENV=development

# Database (Optional: MongoDB Atlas or external MongoDB)
# Leave empty to use the zero-config resilient In-Memory Data Engine.
# Example for MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/suraksha?retryWrites=true&w=majority
MONGODB_URI=

# Authentication
JWT_SECRET=suraksha_production_super_secret_jwt_key_2026_change_in_prod
JWT_REFRESH_SECRET=suraksha_production_refresh_token_super_secret_2026
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Cloud Storage (Optional - for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Emergency Alerts Services (Optional - SMS / WhatsApp notification gateway)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Map & Routing Service (Optional - Google Maps / Mapbox)
MAP_API_KEY=
